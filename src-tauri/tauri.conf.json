{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreeper",
  "version": "0.1.0",
  "identifier": "com.dreeper.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dreeper",
        "label": "main",
        "width": 1340,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
